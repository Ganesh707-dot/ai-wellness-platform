# Neon PostgreSQL (required for production)
# Get from: https://console.neon.tech → Project → Connection string → Pooled
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated origins (Next.js frontend)
CORS_ORIGINS="http://localhost:3000,https://veridian-clinical.vercel.app"

# Groq LLM (same key as Next.js frontend)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Auth (must match Next.js AUTH_SECRET for future JWT validation)
AUTH_SECRET=""
