# Database — paste Neon pooled connection string here
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js / NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-generate-a-long-secret"
NEXTAUTH_SECRET="change-me-generate-a-long-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Optional OAuth (leave blank for email/password demo)
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional email
# RESEND_API_KEY=

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Upstash Redis / Vercel KV for cross-browser clinic booking board
# (same-browser demo works without this via cookie + localStorage sync)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
