# Database — paste Neon pooled connection string here
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js / NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-generate-a-long-secret"
NEXTAUTH_SECRET="change-me-generate-a-long-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Optional OAuth (leave blank for email/password demo)
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional email
# RESEND_API_KEY=

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Upstash Redis / Vercel KV for cross-browser clinic booking board
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: free mini LLMs (intent engine works without these)
# Groq — free tier: https://console.groq.com — ADD TO VERCEL for live conversational AI
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — free tier: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
