{
  "name": "veridian-clinical-api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS enterprise API for Veridian Clinical (Neon PostgreSQL)",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,api}/**/*.ts\" --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:enterprise": "tsx prisma/seed-enterprise.ts",
    "db:studio": "prisma studio",
    "vercel-build": "prisma generate && nest build"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.5",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.16",
    "prisma": "^5.22.0",
    "tsx": "^4.23.11",
    "typescript": "^5.7.3"
  }
}
